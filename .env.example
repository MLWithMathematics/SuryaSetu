# ==============================================================================
# SuryaSetu - Free AI Model Configuration
# Choose ANY of the following free API keys and add it to your .env file!
# ==============================================================================

# Option 1: Google Gemini (RECOMMENDED - Free, text + bill photo OCR)
# Get your free key instantly at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_VISION_MODEL=gemini-3.5-flash

# Option 2: Groq (Blazing fast text reasoning: Llama 3.3 70B & GPT-OSS)
# Get your free key instantly at: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: NVIDIA NIM Open Models (Image-to-Text OCR & Multimodal)
# Get your free key at: https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
# NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# General Settings
PHOTO_ENABLED=true
